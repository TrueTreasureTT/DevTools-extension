{
  "manifest_version": 3,
  "name": "DevToolsUB",
  "version": "0.1.0",
  "description": "Custom developer tools for inspecting pages you are authorized to inspect.",
  "action": { "default_title": "Open DevToolsUB", "default_popup": "ui/popup.html" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["dist/content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["ui/*", "dist/*"], "matches": ["http://*/*", "https://*/*"] }]
}
