{
  "manifest_version": 3,
  "name": "DevToolsUB",
  "version": "0.5.0",
  "description": "Custom developer tools for inspecting pages you are authorized to inspect.",
  "action": {
    "default_title": "Open DevToolsUB",
    "default_popup": "dist/ui/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage", "webNavigation", "webRequest", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["dist/content.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["dist/*"], "matches": ["http://*/*", "https://*/*"]}]
}
